{
  "name": "jooservices/wp-themes",
  "description": "Monorepo for JOOservices WordPress block themes, theme core and companion plugin",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {},
  "require-dev": {},
  "repositories": [
    { "type": "path", "url": "packages/theme-core", "options": { "symlink": true } },
    { "type": "path", "url": "packages/test-kit", "options": { "symlink": true } }
  ],
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": { "php": "8.1.99" },
    "allow-plugins": {}
  },
  "scripts": {
    "validate-all": [
      "composer validate --strict",
      "composer validate --strict --working-dir=packages/theme-core",
      "composer validate --strict --working-dir=packages/test-kit"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
