{
  "name": "jooservices/wp-themes",
  "description": "Monorepo for JOOservices WordPress block themes, theme core and companion plugin",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "brain/monkey": "^2.7",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "mockery/mockery": "^1.6",
    "nikic/php-parser": "^5.9",
    "php-stubs/wp-cli-stubs": "^2.12",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpcov": "^8.2",
    "phpunit/phpunit": "^9.6",
    "qossmic/deptrac": "^2.0",
    "squizlabs/php_codesniffer": "^3.13",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4",
    "wp-phpunit/wp-phpunit": "^7.1",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/theme-core",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "packages/test-kit",
      "options": {
        "symlink": true
      }
    }
  ],
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1.99"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "validate-all": [
      "composer validate --strict",
      "composer validate --strict --working-dir=packages/theme-core",
      "composer validate --strict --working-dir=packages/test-kit"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload-dev": {
    "psr-4": {
      "JOOservices\\TestKit\\": "packages/test-kit/src/",
      "JOOservices\\TestKit\\Tests\\": "packages/test-kit/tests/",
      "JOOservices\\ThemeCore\\": "packages/theme-core/src/",
      "JOOservices\\ThemeCore\\Tests\\": "packages/theme-core/tests/",
      "JOOservices\\Content\\": "plugins/jooservices-content/src/",
      "JOOservices\\Content\\Tests\\": "plugins/jooservices-content/tests/"
    }
  }
}
