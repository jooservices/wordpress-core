msgid "Core SEO output yields to All in One SEO. Noindex posts are not removed from the core sitemap automatically (AIOSEO stores them in its own table)."
msgstr "SEO của theme nhường cho All in One SEO. Bài noindex không tự bị loại khỏi sitemap (AIOSEO lưu chúng trong bảng riêng)."

msgid "Our script handles are excluded from LiteSpeed JS optimisation and defer. Lazy loading yields when LiteSpeed lazy-loads images."
msgstr "Các script của theme được loại khỏi tối ưu JS và defer của LiteSpeed. Lazy load nhường cho LiteSpeed khi nó lazy-load ảnh."

msgid "Our scripts are excluded from WP Rocket minify, defer and \"Delay JavaScript\". Lazy loading yields when WP Rocket lazy-loads images."
msgstr "Các script của theme được loại khỏi minify, defer và \"Delay JavaScript\" của WP Rocket. Lazy load nhường cho WP Rocket khi nó lazy-load ảnh."

msgid "Our script tags are skipped by W3 Total Cache minification. Configure lazy loading in either W3TC or the theme, not both."
msgstr "Các thẻ script của theme được bỏ qua khi W3 Total Cache minify. Hãy cấu hình lazy load ở W3TC hoặc ở theme, không dùng cả hai."

msgid "Our script handles are excluded from Autoptimize aggregation. Lazy loading yields when Autoptimize lazy-loads images."
msgstr "Các script của theme được loại khỏi việc gộp của Autoptimize. Lazy load nhường cho Autoptimize khi nó lazy-load ảnh."

msgid "Lazy loading yields when Smush lazy-loads images. Smush WebP conversion and the theme image sizes work together."
msgstr "Lazy load nhường cho Smush khi nó lazy-load ảnh. Chuyển đổi WebP của Smush hoạt động cùng các kích thước ảnh của theme."

msgid "Lazy loading yields when EWWW lazy-loads images."
msgstr "Lazy load nhường cho EWWW khi nó lazy-load ảnh."

msgid "ShortPixel compresses uploads. Its lazy-loading state cannot be detected reliably, so the theme keeps lazy loading on: switch one of them off if you see double loading."
msgstr "ShortPixel nén ảnh tải lên. Không thể phát hiện chắc chắn trạng thái lazy-load của nó, nên theme vẫn bật lazy load: hãy tắt một trong hai nếu thấy ảnh bị tải hai lần."

msgid "Contact Form 7 assets load only on pages that contain a form."
msgstr "Tài nguyên của Contact Form 7 chỉ tải trên các trang có biểu mẫu."

msgid "Core Open Graph tags win; Jetpack Open Graph is switched off (setting \"Replace Jetpack Open Graph\"). Jetpack lazy images are detected."
msgstr "Thẻ Open Graph của theme được ưu tiên; Open Graph của Jetpack bị tắt (thiết lập \"Replace Jetpack Open Graph\"). Lazy images của Jetpack được phát hiện."

msgid "Core SEO output yields to Rank Math. The primary category and noindex flags are read from it."
msgstr "SEO của theme nhường cho Rank Math. Chuyên mục chính và cờ noindex được đọc từ plugin này."

msgid "Core SEO output yields to SEOPress. The primary category and noindex flags are read from it."
msgstr "SEO của theme nhường cho SEOPress. Chuyên mục chính và cờ noindex được đọc từ plugin này."

msgid "Basic support (Tier 3): cart, checkout and account are noindex, excluded from speculation rules and never lazy-fragmented. No storefront design is shipped."
msgstr "Hỗ trợ cơ bản (Tier 3): giỏ hàng, thanh toán và tài khoản là noindex, bị loại khỏi speculation rules và không bao giờ lazy-fragment. Không kèm thiết kế cửa hàng."

msgid "Core SEO output yields to Yoast SEO. The primary category and noindex flags are read from it."
msgstr "SEO của theme nhường cho Yoast SEO. Chuyên mục chính và cờ noindex được đọc từ plugin này."

msgid "No changes needed: Site Kit tags are left alone and are not counted in the script budgets."
msgstr "Không cần thay đổi: thẻ của Site Kit được giữ nguyên và không tính vào ngân sách script."

msgid "No changes needed: tables use the theme tokens through the table block styles."
msgstr "Không cần thay đổi: bảng dùng token của theme qua style của block bảng."

msgid "Use Compat\\Acf::field() in templates; it is guarded against ACF being inactive."
msgstr "Hãy dùng Compat\\Acf::field() trong template; hàm đã được bảo vệ khi ACF không hoạt động."

msgid "No changes needed: the comment form posts normally, also when comments are lazy-loaded."
msgstr "Không cần thay đổi: biểu mẫu bình luận gửi bình thường, kể cả khi bình luận được lazy-load."

msgid "If the firewall blocks the REST route joo/v1, allow-list /wp-json/joo/v1/."
msgstr "Nếu tường lửa chặn REST route joo/v1, hãy cho phép /wp-json/joo/v1/."

msgid "WPForms loads its assets only where a form is present."
msgstr "WPForms chỉ tải tài nguyên ở nơi có biểu mẫu."

msgid "Fluent Forms loads its assets only where a form is present."
msgstr "Fluent Forms chỉ tải tài nguyên ở nơi có biểu mẫu."

msgid "Supported: the SEO and language fields have classic meta boxes."
msgstr "Được hỗ trợ: các trường SEO và ngôn ngữ có meta box cổ điển."

msgid "Tier 3: use the Canvas page template; core content filters skip builder pages."
msgstr "Tier 3: dùng template trang Canvas; các bộ lọc nội dung của theme bỏ qua trang dựng bằng page builder."

