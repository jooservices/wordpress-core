# Copy to .env with `make init-env` (random secrets are generated, never commit .env)
WP_VERSION=latest
WP_PORT=8080
MAIL_PORT=8025
WP_SITE_URL=http://127.0.0.1:8080
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=
DB_ROOT_PASSWORD=
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.test
