{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": [
    "**/node_modules/**",
    "**/build/**",
    "**/vendor/**",
    "artifacts/**",
    "themes/*/core/**",
    "tests/tooling/fixtures/**",
    "themes/*/assets/critical/**"
  ],
  "rules": {
    "declaration-no-important": true,
    "color-no-hex": true,
    "custom-property-pattern": null,
    "selector-class-pattern": [
      "^(joo|wp|is|has|screen-reader|align|admin|editor|edit|current|children|comment|submit|post-navigation|post-page-numbers|page-numbers)[a-z0-9-_]*(__[a-z0-9-]+)?(--[a-z0-9-]+)?$",
      {
        "message": "Class names must start with joo-, wp-, is-, has-, or be a WordPress utility or generated class"
      }
    ],
    "declaration-property-value-disallowed-list": {
      "width": ["/100vw/"],
      "max-width": ["/100vw/"],
      "min-width": ["/100vw/"],
      "text-align": ["left", "right"],
      "float": ["left", "right"],
      "clear": ["left", "right"]
    },
    "import-notation": null,
    "no-descending-specificity": null,
    "color-function-notation": null,
    "alpha-value-notation": null,
    "media-feature-range-notation": null,
    "property-no-vendor-prefix": null,
    "value-no-vendor-prefix": null,
    "declaration-block-no-redundant-longhand-properties": null,
    "property-disallowed-list": [
      [
        "/^(margin|padding)-(left|right)$/",
        "/^border-(left|right)(-.+)?$/",
        "/^border-(top|bottom)-(left|right)-radius$/",
        "/^scroll-(margin|padding)-(left|right)$/",
        "left",
        "right"
      ],
      {
        "message": "Use logical properties (margin-inline-*, padding-inline-*, border-inline-*, inset-inline-*) so the layout mirrors in RTL"
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/design-tokens/**/*.css"],
      "rules": {
        "color-no-hex": null
      }
    },
    {
      "files": ["packages/*/resources/admin/*.css"],
      "rules": {
        "color-no-hex": null
      }
    }
  ]
}
