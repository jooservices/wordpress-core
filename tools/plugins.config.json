{
  "$comment": "Plugins that the demo mounts and that are packaged for a server. `source` is relative to the repository root.",
  "plugins": {
    "jooservices-content": {
      "name": "JOOservices Content",
      "source": "plugins/jooservices-content",
      "mainFile": "jooservices-content.php",
      "composer": false,
      "exclude": ["tests/", "node_modules/", ".DS_Store"]
    },
    "wordpress-chatgpt": {
      "name": "JOOservices WordPress - MCP",
      "source": "../wordpress-mcp/packages/wordpress-plugin",
      "sourceEnv": "MCP_PLUGIN_SRC",
      "mainFile": "wordpress-chatgpt.php",
      "composer": true,
      "exclude": [
        ".phpunit.result.cache",
        "build/",
        "tests/",
        "tools/",
        "vendor/",
        "Dockerfile",
        "phpunit.xml",
        "phpunit.live.xml",
        "phpstan.neon",
        "phpmd.xml.dist",
        "phpcs.xml.dist",
        "pint.json",
        "captainhook.json",
        "composer.lock",
        ".DS_Store"
      ]
    }
  }
}
