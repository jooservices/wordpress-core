{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["packages/*/resources/js/**/*.js", "themes/*/assets/src/js/**/*.js"],
  "exclude": ["**/node_modules/**", "**/build/**", "**/*.test.js"]
}
