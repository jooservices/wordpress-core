{
  "schema": 1,
  "slug": "starter",
  "name": "Starter",
  "core": "^0.1",
  "modules": {
    "seo": true,
    "lazy": true,
    "perf": true,
    "compat": true,
    "blocks": true,
    "i18n": true,
    "terminal": true,
    "content": true
  },
  "design": {
    "colorSchemes": ["dark", "light"],
    "defaultScheme": "light"
  },
  "menus": {
    "primary": "Primary menu",
    "footer": "Footer menu"
  },
  "imageSizes": [
    {
      "name": "joo-card",
      "w": 640,
      "h": 480,
      "crop": true,
      "retina": true
    },
    {
      "name": "joo-cover",
      "w": 900,
      "h": 386,
      "crop": true,
      "retina": true
    },
    {
      "name": "joo-thumb",
      "w": 88,
      "h": 88,
      "crop": true
    },
    {
      "name": "joo-avatar",
      "w": 128,
      "h": 128,
      "crop": true
    }
  ],
  "seo": {
    "siteType": "blog"
  },
  "lazy": {
    "enabled": true
  },
  "i18n": {
    "default": "en",
    "languages": ["en", "vi"]
  },
  "images": {
    "sizesPresets": {
      "card": "(min-width: 900px) 220px, 100vw",
      "cover": "(min-width: 1240px) 900px, 100vw",
      "thumb": "44px"
    }
  },
  "features": {
    "terminal": true,
    "slider": true,
    "theme_toggle": true,
    "reading_progress": true
  }
}
