{
  "$schema": "https://jooservices.com/schemas/joo-theme-1.json",
  "schema": 1,
  "slug": "jooservices",
  "name": "JOOservices",
  "core": "^0.1",
  "modules": {
    "seo": true,
    "lazy": true,
    "perf": true,
    "compat": true,
    "blocks": true,
    "i18n": true,
    "terminal": true,
    "content": true
  },
  "features": {
    "terminal": true,
    "slider": true,
    "theme_toggle": true,
    "reading_progress": true,
    "hide_featured_in_list": true
  },
  "design": {
    "colorSchemes": ["dark", "light", "ocean", "forest", "paper"],
    "defaultScheme": "dark",
    "followSystem": true,
    "tokens": "design/tokens.json"
  },
  "menus": {
    "primary": "Primary menu",
    "footer": "Footer menu"
  },
  "imageSizes": [
    {
      "name": "joo-card",
      "w": 640,
      "h": 480,
      "crop": true,
      "retina": true
    },
    {
      "name": "joo-cover",
      "w": 900,
      "h": 386,
      "crop": true,
      "retina": true
    },
    {
      "name": "joo-thumb",
      "w": 88,
      "h": 88,
      "crop": true
    },
    {
      "name": "joo-avatar",
      "w": 128,
      "h": 128,
      "crop": true
    }
  ],
  "images": {
    "sizesPresets": {
      "card": "(min-width: 900px) 220px, 100vw",
      "cover": "(min-width: 1240px) 900px, 100vw",
      "thumb": "44px"
    }
  },
  "seo": {
    "siteType": "blog",
    "yield": "auto",
    "titleSeparator": "|",
    "organization": {
      "name": "JOOservices Ltd",
      "url": "https://jooservices.com"
    },
    "person": {
      "userId": 0
    }
  },
  "lazy": {
    "enabled": true,
    "images": true,
    "iframes": true,
    "fragments": true,
    "sections": true,
    "comments": true,
    "eagerCount": 1
  },
  "perf": {
    "fonts": [
      {
        "family": "IBM Plex Sans",
        "files": ["assets/fonts/ibm-plex-sans-latin.woff2"],
        "weight": "400 600",
        "display": "swap",
        "preload": true,
        "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD",
        "fallback": {
          "family": "Arial",
          "sizeAdjust": "101.6%",
          "ascentOverride": "100.9%",
          "descentOverride": "27.1%",
          "lineGapOverride": "0%"
        }
      },
      {
        "family": "IBM Plex Sans",
        "files": ["assets/fonts/ibm-plex-sans-vietnamese.woff2"],
        "weight": "400 600",
        "display": "swap",
        "unicodeRange": "U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB"
      },
      {
        "family": "JetBrains Mono",
        "files": ["assets/fonts/jetbrains-mono-latin.woff2"],
        "weight": "400 700",
        "display": "swap",
        "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD",
        "fallback": {
          "family": "Courier New",
          "sizeAdjust": "100%",
          "ascentOverride": "102%",
          "descentOverride": "30%",
          "lineGapOverride": "0%"
        }
      },
      {
        "family": "JetBrains Mono",
        "files": ["assets/fonts/jetbrains-mono-vietnamese.woff2"],
        "weight": "400 700",
        "display": "swap",
        "unicodeRange": "U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB"
      }
    ],
    "preload": [],
    "preconnect": [],
    "budgets": "budgets.json"
  },
  "compat": {
    "tiers": {
      "tier1": ["yoast", "rankmath", "aioseo", "seopress", "litespeed-cache", "polylang"]
    }
  },
  "i18n": {
    "default": "en",
    "languages": ["en", "vi"]
  },
  "terminal": {
    "banner": "jooservices.com read-only shell",
    "shortcuts": ["ls", "tree", "help", "grep -ri docker ."],
    "maxPosts": 500
  },
  "blocks": {
    "categoryLabel": "JOOservices",
    "patternCategory": "jooservices",
    "patternCategoryLabel": "JOOservices",
    "notFoundPlaceholder": "/ai/prompt-caching",
    "disabled": [],
    "patterns": ["patterns"],
    "canvas": true
  },
  "content": {
    "provider": "wp",
    "profilePagePath": "about"
  }
}
