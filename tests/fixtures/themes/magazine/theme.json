{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "720px", "wideSize": "1200px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "background", "name": "Background", "color": "#ffffff" },
        { "slug": "surface", "name": "Surface", "color": "#f4f6f8" },
        { "slug": "ink", "name": "Ink", "color": "#16202a" },
        { "slug": "muted", "name": "Muted", "color": "#5a6775" },
        { "slug": "accent", "name": "Accent", "color": "#0b6bcb" },
        { "slug": "border", "name": "Border", "color": "#d5dbe1" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System",
          "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Monospace",
          "fontFamily": "ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "base", "name": "Base", "size": "1.0625rem" },
        { "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
        { "slug": "xl", "name": "Extra large", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "20", "name": "Small", "size": "0.5rem" },
        { "slug": "30", "name": "Medium", "size": "1rem" },
        { "slug": "40", "name": "Large", "size": "1.5rem" },
        { "slug": "50", "name": "XL", "size": "2.5rem" }
      ]
    },
    "custom": { "radius": "0.5rem" }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--background)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--system)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.65" },
    "spacing": { "blockGap": "1.25rem", "padding": { "left": "1rem", "right": "1rem" } },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--accent)" } },
      "heading": { "typography": { "lineHeight": "1.25" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } }
    },
    "blocks": {
      "core/code": { "typography": { "fontFamily": "var(--wp--preset--font-family--mono)" } }
    },
    "css": "html{color-scheme:light}:root[data-theme='light']{color-scheme:light}:focus-visible{outline:2px solid var(--wp--preset--color--accent);outline-offset:2px}img{max-width:100%;height:auto}.joo-block-title{font-size:var(--wp--preset--font-size--large)}.joo-pill{display:inline-block;padding:.125rem .5rem;font-size:.75rem;border:1px solid var(--wp--preset--color--border);border-radius:999px}.wp-site-blocks>*+*{margin-block-start:0}"
  }
}
