# Themes, JOOservices Resume, test kit and tools. A baseline is allowed only with a Jira key per entry.
parameters:
  phpVersion: 80300
  level: 6
  paths:
    - themes
    - plugins
    - packages/test-kit/src
    - tools
  excludePaths:
    - themes/*/core
    - themes/*/core/*
    - themes/*/core/**
    - themes/*/node_modules
    - themes/*/assets/build
    - tools/bc
  bootstrapFiles:
    - tests/phpstan-bootstrap.php
  treatPhpDocTypesAsCertain: false
  reportUnmatchedIgnoredErrors: true
  scanDirectories:
    - vendor/wp-phpunit/wp-phpunit/includes
