<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap-unit.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         cacheResultFile=".phpunit.result.cache">
  <testsuites>
    <testsuite name="core-unit"><directory>packages/theme-core/tests/Unit</directory></testsuite>
    <testsuite name="kit-unit"><directory>packages/test-kit/tests</directory><exclude>packages/test-kit/tests/Integration</exclude></testsuite>
    <testsuite name="plugin-unit"><directory>plugins/jooservices-content/tests/Unit</directory></testsuite>
    <testsuite name="theme-unit"><directory>themes/jooservices/tests/Unit</directory><directory>themes/starter/tests/Unit</directory></testsuite>
    <testsuite name="tools-unit"><directory>tests/tools</directory></testsuite>
  </testsuites>
  <coverage processUncoveredFiles="true">
    <include>
      <directory suffix=".php">packages/theme-core/src</directory>
      <directory suffix=".php">plugins/jooservices-content/src</directory>
      <directory suffix=".php">themes/jooservices/inc</directory>
      <directory suffix=".php">themes/starter/inc</directory>
    </include>
  </coverage>
</phpunit>
