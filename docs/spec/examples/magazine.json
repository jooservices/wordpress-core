{
  "schema": 1,
  "slug": "magazine",
  "name": "Magazine",
  "core": "^0.1",
  "modules": {
    "seo": true,
    "lazy": true,
    "perf": true,
    "compat": true,
    "blocks": true,
    "i18n": true,
    "terminal": false,
    "content": true
  },
  "features": {
    "slider": true,
    "terminal": false,
    "theme_toggle": false
