  },
  "imageSizes": [
    {
      "name": "mag-hero",
      "w": 1200,
      "h": 675,
      "crop": true
    },
    {
      "name": "mag-tile",
      "w": 480,
      "h": 320,
      "crop": true
    }
  ],
  "seo": {
    "siteType": "magazine",
    "yield": "auto"
  },
  "lazy": {
    "enabled": true,
    "fragments": true
  },
  "blocks": {
    "disabled": ["joo/companies", "joo/profile-card", "joo/terminal-dock"],
    "patterns": ["magazine"]
