{
  "version": 1,
  "options": [
    "joo_{theme_slug}_settings",
    "joo_cache_version",
    "joo_cache_tags",
    "joo_demo_checksum",
    "joo_content_version",
    "joo_content_flush_rewrite",
    "joo_settings_schema_version"
  ],
  "transients": ["joo_manifest_{slug}_{hash}"],
  "postMeta": [
    "_joo_featured",
    "_joo_featured_order",
    "_joo_lazy_override",
    "_joo_seo_title",
    "_joo_seo_description",
    "_joo_seo_noindex",
    "_joo_seo_canonical",
    "_joo_seo_og_image",
    "_joo_lang",
    "_joo_translation_of",
    "_joo_primary_category",
    "_joo_demo"
  ],
  "postMetaInternal": [
    "_joo_reading_cache",
    "_joo_company_role",
    "_joo_company_from",
    "_joo_company_to",
    "_joo_company_pinned",
    "_joo_company_url",
    "_joo_company_logo_id"
  ],
  "termMeta": ["joo_short_description", "joo_image_id", "joo_intro", "joo_icon"],
  "userMeta": ["joo_title", "joo_short_bio", "joo_avatar_id", "joo_socials", "joo_dismissed_notices"],
  "postTypes": ["joo_company"],
  "restRoutes": [
    "/companies",
    "/categories/tree",
    "/topics",
    "/featured",
    "/related/(?P<post_id>\\d+)",
    "/profile",
    "/fragment/(?P<name>[a-z0-9-]+)",
    "/terminal/fs"
  ],
  "blocks": [
    "joo/breadcrumbs",
    "joo/featured-slider",
    "joo/post-meta",
    "joo/toc",
    "joo/related-posts",
    "joo/author-box",
    "joo/theme-toggle",
    "joo/lang-switcher",
    "joo/search-trigger",
    "joo/profile-card",
    "joo/companies",
    "joo/category-tree",
    "joo/top-topics",
    "joo/tag-list",
    "joo/terminal-dock",
    "joo/reading-progress",
    "joo/not-found",
    "joo/term-chips",
    "joo/archive-count",
    "joo/term-intro",
    "joo/term-image",
    "joo/author-stats"
  ],
  "customElements": [
    "joo-slider",
    "joo-lazy",
    "joo-embed",
    "joo-toc",
    "joo-terminal",
    "joo-companies",
    "joo-tree",
    "joo-theme-toggle",
    "joo-progress",
    "joo-404"
  ],
  "hooks": [
    "joo/core/ready",
    "joo/core/modules",
    "joo/core/services",
    "joo/settings/defaults",
    "joo/settings/value",
    "joo/seo/context",
    "joo/seo/title",
    "joo/seo/description",
    "joo/seo/canonical",
    "joo/seo/canonical_query_args",
    "joo/seo/robots",
    "joo/seo/og",
    "joo/seo/graph/pieces",
    "joo/seo/schema/{piece}",
    "joo/seo/yield",
    "joo/seo/x_default",
    "joo/seo/profile_page",
    "joo/lazy/policy",
    "joo/lazy/should_lazy",
    "joo/lazy/embed_providers",
    "joo/assets/register",
    "joo/assets/runtime_config",
    "joo/assets/inline_script_nonce",
    "joo/perf/preload",
    "joo/perf/bloat",
    "joo/compat/adapters",
    "joo/compat/forms_conditional",
    "joo/compat/acf_field",
    "joo/blocks/register",
    "joo/blocks/data/{slug}",
    "joo/blocks/html/{slug}",
    "joo/breadcrumbs/trail",
    "joo/profile/url",
    "joo/i18n/locales",
    "joo/terminal/commands",
    "joo/terminal/fs",
    "joo/compat/report",
    "joo/perf/image_formats",
    "joo/lazy/provider"
  ]
}
